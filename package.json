{
  "name": "anima-connect",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "desktop:compile": "tsc -p tsconfig.desktop.json",
    "desktop:dev": "pnpm build && pnpm desktop:compile && electron .",
    "desktop:browser": "node scripts/install-desktop-browser.cjs",
    "desktop:dist": "pnpm build && pnpm desktop:compile && pnpm desktop:browser && electron-builder --win nsis --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.animaconnect.desktop",
    "productName": "Anima Connect",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "dist/**/*", ".desktop-build/**/*", "node_modules/**/*", "package.json"],
    "extraResources": [{ "from": ".playwright-browsers", "to": "playwright-browsers" }],
    "asar": true,
    "asarUnpack": ["node_modules/playwright-core/.local-browsers/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
